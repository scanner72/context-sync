# Environment variables for Remote Context Store MCP Service

# Security: Bearer token for client authentication
# Generate with: openssl rand -hex 32
AUTH_TOKEN=your-super-secret-bearer-token-here

# Database connection string
DATABASE_URL=postgresql+asyncpg://context_user:context_password@db:5432/context_db

# Embedding provider: "fastembed" (local CPU, recommended), "openai", or "ollama"
EMBEDDING_PROVIDER=fastembed

# FastEmbed model name (384-dim default, runs on CPU quickly)
# Examples: "BAAI/bge-small-en-v1.5", "sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2"
FASTEMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

# OpenAI Configuration (only if EMBEDDING_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Ollama Configuration (only if EMBEDDING_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Server settings
HOST=0.0.0.0
PORT=8000
DEBUG=false
ALLOWED_ORIGINS=*
