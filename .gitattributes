# Auto-detect text files and normalize line endings
* text=auto

# Scripts for Linux and macOS must always use LF
*.sh text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sql text eol=lf

# Windows scripts
*.ps1 text eol=crlf
*.bat text eol=crlf
